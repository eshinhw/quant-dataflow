{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-dataflow.internal/schemas/raw-daily-bar.schema.json",
  "title": "RawDailyBar",
  "description": "Raw ES futures daily OHLCV bar as landed in S3, matching data-model.md#RawDailyBar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_ticker",
    "trade_date",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "source",
    "ingested_at",
    "code_version",
    "config_version",
    "run_id"
  ],
  "properties": {
    "contract_ticker": {
      "type": "string",
      "pattern": "^ES[HMUZ][0-9]$",
      "description": "ES futures contract ticker with single-digit year, e.g. ESZ5 for Dec 2025"
    },
    "trade_date": {
      "type": "string",
      "format": "date"
    },
    "open": { "type": "number", "exclusiveMinimum": 0 },
    "high": { "type": "number", "exclusiveMinimum": 0 },
    "low": { "type": "number", "exclusiveMinimum": 0 },
    "close": { "type": "number", "exclusiveMinimum": 0 },
    "volume": { "type": "integer", "minimum": 0 },
    "source": { "const": "polygon.io" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "code_version": { "type": "string", "minLength": 1 },
    "config_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "format": "uuid" }
  }
}
