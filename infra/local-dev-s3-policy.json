{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RawZoneBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::quant-dataflow"
    },
    {
      "Sid": "RawZoneObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::quant-dataflow/raw/*",
        "arn:aws:s3:::quant-dataflow/lineage/*"
      ]
    }
  ]
}
