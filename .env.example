# Copy this file to .env and fill in real values: cp .env.example .env
# .env is gitignored and never committed; this file is committed as documentation.

# Required. S3 bucket the raw zone is written to.
RAW_BUCKET_NAME=my-raw-bucket

# Required (local dev): your Polygon.io API key.
# In deployed environments, POLYGON_API_KEY_SECRET_ARN is used instead — see README.md.
POLYGON_API_KEY=your-polygon-api-key

# Optional. Bounded retry attempts for transient Polygon.io failures.
RETRY_MAX_ATTEMPTS=5

# Optional. Base seconds for exponential backoff between retries.
RETRY_BACKOFF_BASE_SECONDS=1.0

# Optional. Recorded on every ingested artifact for lineage.
CODE_VERSION=unknown
